# ─────────────────────────────────────────────
# iConnect Docker Compose — Environment Variables
# ─────────────────────────────────────────────

# ── Supabase Credentials ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── OpenAI / Azure Embedding Credentials ──
EMBEDDING_API_KEY=sk-your-embedding-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMS=512

# ── WooCommerce Store Credentials ──
WC_URL=https://iconnect-intl.com/store/wp-json/wc/v3
WC_KEY=ck_your_woocommerce_consumer_key
WC_SECRET=cs_your_woocommerce_consumer_secret
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36
WC_COOKIE=humans_21909=1
WC_WEBHOOK_SECRET=your_webhook_secret

# ── Delta Sync ──
SYNC_ENABLED=true
SYNC_INTERVAL_MIN=5

# ── n8n Configuration ──
N8N_HOST=n8n.asra3.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.asra3.com/
