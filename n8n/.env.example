# ============================================================
# n8n .env — copy to `.env` and fill in. NEVER commit the real one.
# ============================================================

# Pin to the version your workflows were built/tested on (old n8n → Settings → About).
# Leaving `latest` risks a major bump breaking node typeVersions.
N8N_VERSION=latest

# ── Domain / reverse proxy ──
N8N_HOST=n8n.your-domain.com
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://n8n.your-domain.com/
WEBHOOK_URL=https://n8n.your-domain.com/
WEBHOOK_TUNNEL_URL=https://n8n.your-domain.com
N8N_PROXY_HOPS=1
N8N_PUSH_BACKEND=websocket

# ── Postgres (used by BOTH the postgres container and n8n) ──
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgresql
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=change-me
DB_POSTGRESDB_PASSWORD=change-me
DB_POSTGRESDB_SCHEMA=public

# ── Encryption key ──
# n8n generates one on first start and stores it in the n8n-data volume.
# ONLY set this if migrating from another instance — it must match the old key
# or imported credentials will be unreadable. Get it from the old box with:
#   docker exec <old-n8n> cat /home/node/.n8n/config
# N8N_ENCRYPTION_KEY=

# ── Timezone ──
GENERIC_TIMEZONE=Africa/Cairo
TZ=Africa/Cairo

# ── Other settings ──
N8N_COMMUNITY_PACKAGES_ENABLED=true
N8N_COMMUNITY_PACKAGES_ALLOW_TOOL_USAGE=true
N8N_REINSTALL_MISSING_PACKAGES=true
N8N_RUNNERS_ENABLED=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_DISABLE_PRODUCTION_MAIN_PROCESS_RESPONSE_COMPRESSION=true
N8N_PUBLIC_FILES_BASE_URL=https://n8n.your-domain.com/public_files/
N8N_RESTRICT_FILE_ACCESS_TO=/home/node/.n8n;/mnt/shared_files
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_MIGRATE_FS_STORAGE_PATH=true
NODEJS_PREFER_IPV4=true
