# ============================================================
# ROOT .env — read automatically by `docker compose`
# Copy to `.env` and fill in. ONE file powers all 4 services.
#   cp .env.example .env  &&  nano .env
# NEVER commit the real .env (it's gitignored).
# ============================================================

# ── Supabase (shared: backends use SUPABASE_URL, dashboard uses NEXT_PUBLIC_*) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Embeddings (Backend A) — OpenAI or any OpenAI-compatible endpoint (Azure) ──
EMBEDDING_API_KEY=your-embedding-key
EMBEDDING_BASE_URL=https://your-azure-resource.services.ai.azure.com/openai/v1
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMS=512
FTS_CONFIG=arabic
DOCUMENTS_TABLE=documents
CORS_ORIGIN=*

# ── WooCommerce wrapper (Backend B) ──
WC_URL=https://iconnect-intl.com/store/wp-json/wc/v3
WC_KEY=ck_your_key_here
WC_SECRET=cs_your_secret_here
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36
WC_COOKIE=humans_21909=1
WC_WEBHOOK_SECRET=your-webhook-secret
SYNC_ENABLED=true
SYNC_INTERVAL_MIN=5

# ── Dashboard → n8n (optional fallback; prefer per-channel agent_webhook_url in the UI) ──
NEXT_PUBLIC_N8N_AGENT_WEBHOOK_URL=

# ── n8n ──
# Pin N8N_VERSION to the version your workflow was built/tested on (avoid surprise
# breaking changes from :latest). Check your current n8n: Settings → About.
N8N_VERSION=latest
N8N_HOST=n8n.your-domain.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.your-domain.com/
GENERIC_TIMEZONE=Asia/Riyadh
