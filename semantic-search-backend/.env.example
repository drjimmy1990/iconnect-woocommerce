# ─────────────────────────────────────────────
# Semantic Search Backend — Environment Variables
# ─────────────────────────────────────────────

# Supabase connection (use service-role key for server-side RPC + table access)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Embedding configuration — works with the official OpenAI API OR any
# OpenAI-compatible /v1/embeddings endpoint (custom/self-hosted, proxy, etc.).
# Point EMBEDDING_BASE_URL at your custom endpoint when ready; leave it unset
# to use the default https://api.openai.com/v1.
EMBEDDING_API_KEY=sk-your-embedding-key
# OPENAI_API_KEY is read as a fallback if EMBEDDING_API_KEY is unset.
# OPENAI_API_KEY=sk-your-openai-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMS=512

# Full-text search config — the generated tsvector column in SQL uses a FIXED config.
# This env var is for documentation / reference only; switching languages requires
# re-running sql/001_init.sql with the new config value baked into the column definition.
FTS_CONFIG=arabic

# Postgres table name (must match the table created in sql/001_init.sql)
DOCUMENTS_TABLE=documents

# HTTP server
PORT=8080
CORS_ORIGIN=*
