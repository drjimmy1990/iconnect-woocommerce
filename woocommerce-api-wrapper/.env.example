# WooCommerce REST API
WC_URL=https://iconnect-intl.com/store/wp-json/wc/v3
WC_KEY=ck_4daa8ed707bac1a4d7e2c442bb7de05099c7c05b
WC_SECRET=cs_234e5af2614e76e372b33675fbcc3ea80eedba3e

# Full browser User-Agent — a short UA is blocked by mod_security (406)
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36

# Origin JS-challenge cookie — required, else requests get 409 (SiteLock "humans_*")
WC_COOKIE=humans_21909=1

# Semantic backend (backend A) base URL
SEMANTIC_BACKEND_URL=http://localhost:8080

# WooCommerce webhook secret (set in WC webhook config)
WC_WEBHOOK_SECRET=your_webhook_secret_here

# Server
PORT=8081

# Delta-sync
SYNC_ENABLED=true
SYNC_INTERVAL_MIN=5
